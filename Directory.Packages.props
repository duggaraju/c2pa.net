<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Azure.CodeSigning.Sdk" Version="0.1.164" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="System.Text.Json" Version="10.0.2" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageVersion Include="libclang.runtime.linux-x64" Version="23.1.5" />
    <PackageVersion Include="libClangSharp.runtime.linux-x64" Version="23.1.5" />
    <PackageVersion Include="libclang.runtime.linux-arm64" Version="23.1.5" />
    <PackageVersion Include="libClangSharp.runtime.linux-arm64" Version="23.1.5" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageVersion Include="libclang.runtime.osx-arm64" Version="23.1.5" />
    <PackageVersion Include="libClangSharp.runtime.osx-arm64" Version="23.1.5" />
  </ItemGroup>
</Project>
