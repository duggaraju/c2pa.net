<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Title>Content Authenticity .NET Library</Title>
    <Authors>Prakash Duggaraju</Authors>
    <Description>.NET Bindings on top of Rust c2pa-rs library.</Description>
    <Copyright>Copyright (c) Prakash Duggaraju 2025</Copyright>
    <PackageProjectUrl>https://github.com/duggaraju/c2pa.net</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/duggaraju/c2pa.net</RepositoryUrl>
    <BindingsFolder>Bindings</BindingsFolder>
    <QuicktypeVersion Condition="'$(QuicktypeVersion)' == ''">26.0.0</QuicktypeVersion>
    <BuildArm64 Condition="'$(BuildArm64)' == ''">false</BuildArm64>
    <HostArchitectureName Condition="'$(HostArchitectureName)' == '' and !$([MSBuild]::IsOSPlatform('OSX'))">x64</HostArchitectureName>
    <HostArchitectureName Condition="'$(HostArchitectureName)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">arm64</HostArchitectureName>
    <BuildLinuxMusl Condition="'$(BuildLinuxMusl)' == ''">false</BuildLinuxMusl>
    <IncludeLinuxMusl Condition="'$(IncludeLinuxMusl)' == ''">$(BuildLinuxMusl)</IncludeLinuxMusl>
    <LinuxMuslLibraryPath Condition="'$(LinuxMuslLibraryPath)' == ''">$(MSBuildThisFileDirectory)../c2pa-rs/target/x86_64-unknown-linux-musl/$(Configuration.ToLower())/libc2pa_c.so</LinuxMuslLibraryPath>
    <EnableCargoReleaseOptimizations Condition="'$(EnableCargoReleaseOptimizations)' == ''">false</EnableCargoReleaseOptimizations>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddNativeRuntimesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>LINUX</DefineConstants>
    <HostPlatformName>linux</HostPlatformName>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>WINDOWS</DefineConstants>
    <HostPlatformName>win</HostPlatformName>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DefineConstants>OSX</DefineConstants>
    <HostPlatformName>osx</HostPlatformName>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ContentAuthenticity.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <DeprecatedNativeApi Include="c2pa_load_settings" />
    <DeprecatedNativeApi Include="c2pa_release_string" />
    <DeprecatedNativeApi Include="c2pa_string_free" />
    <DeprecatedNativeApi Include="c2pa_reader_from_stream" />
    <DeprecatedNativeApi Include="c2pa_reader_from_file" />
    <DeprecatedNativeApi Include="c2pa_reader_from_manifest_data_and_stream" />
    <DeprecatedNativeApi Include="c2pa_reader_free" />
    <DeprecatedNativeApi Include="c2pa_builder_from_json" />
    <DeprecatedNativeApi Include="c2pa_builder_from_archive" />
    <DeprecatedNativeApi Include="c2pa_builder_free" />
    <DeprecatedNativeApi Include="c2pa_builder_data_hashed_placeholder" />
    <DeprecatedNativeApi Include="c2pa_builder_sign_data_hashed_embeddable" />
    <DeprecatedNativeApi Include="c2pa_format_embeddable" />
    <DeprecatedNativeApi Include="c2pa_manifest_bytes_free" />
    <DeprecatedNativeApi Include="c2pa_signer_from_settings" />
    <DeprecatedNativeApi Include="c2pa_signer_free" />
    <DeprecatedNativeApi Include="c2pa_signature_free" />
    <BindingsPlatform Include="win-x64">
      <CargoTarget>x86_64-pc-windows-msvc</CargoTarget>
      <NativeLibrary>c2pa_c.dll</NativeLibrary>
    </BindingsPlatform>
    <BindingsPlatform Include="win-arm64">
      <CargoTarget>aarch64-pc-windows-msvc</CargoTarget>
      <NativeLibrary>c2pa_c.dll</NativeLibrary>
    </BindingsPlatform>
    <BindingsPlatform Include="linux-x64">
      <CargoTarget>x86_64-unknown-linux-gnu</CargoTarget>
      <NativeLibrary>libc2pa_c.so</NativeLibrary>
    </BindingsPlatform>
    <BindingsPlatform Include="linux-arm64">
      <CargoTarget>aarch64-unknown-linux-gnu</CargoTarget>
      <NativeLibrary>libc2pa_c.so</NativeLibrary>
    </BindingsPlatform>
    <BindingsPlatform Include="osx-x64">
      <CargoTarget>x86_64-apple-darwin</CargoTarget>
      <NativeLibrary>libc2pa_c.dylib</NativeLibrary>
    </BindingsPlatform>
    <BindingsPlatform Include="osx-arm64">
      <CargoTarget>aarch64-apple-darwin</CargoTarget>
      <NativeLibrary>libc2pa_c.dylib</NativeLibrary>
    </BindingsPlatform>
    <SchemaFile Include="../c2pa-rs/target/schema/Reader.schema.json" Namespace="Reader" GeneratedFile="Reader.cs" />
    <SchemaFile Include="../c2pa-rs/target/schema/ManifestDefinition.schema.json" Namespace="Builder" GeneratedFile="ManifestDefinition.cs" />
    <SchemaFile Include="../c2pa-rs/target/schema/Settings.schema.json" Namespace="Settings" GeneratedFile="Settings.cs" />
  </ItemGroup>

  <!-- libclang runtime only needed for binding generation -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) or $([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="libClangSharp.runtime.$(HostPlatformName)-$(HostArchitectureName)" GeneratePathProperty="true" IncludeAssets="none" />
    <PackageReference Include="libclang.runtime.$(HostPlatformName)-$(HostArchitectureName)" GeneratePathProperty="true" IncludeAssets="none" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>/</PackagePath>
    </None>
    <Compile Include="*.cs" />
    <Compile Include="$(MSBuildProjectDirectory)/Schema/StandardAssertions.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(IncludeLinuxMusl)' == 'true'">
    <!-- Built separately with a musl toolchain; never use it for host binding/schema generation. -->
    <Content Include="$(LinuxMuslLibraryPath)" CopyToOutputDirectory="PreserveNewest" Link="runtimes/linux-musl-x64/native/libc2pa_c.so" Pack="true" PackagePath="runtimes/linux-musl-x64/native/" />
  </ItemGroup>

  <Target Name="BuildMuslNativeLibrary" BeforeTargets="PrepareForBuild" Condition="'$(BuildLinuxMusl)' == 'true' and '$(NoBuild)' != 'true'">
    <Error Condition="!$([MSBuild]::IsOSPlatform('Linux')) or '$(HostArchitectureName)' != 'x64'" Text="BuildLinuxMusl requires an x64 Linux build host. musl ARM64 support is deferred." />
    <PropertyGroup>
      <MuslCargoEnvironmentVariables Condition="'$(Configuration)' == 'Release' and '$(EnableCargoReleaseOptimizations)' == 'true'">CARGO_PROFILE_RELEASE_OPT_LEVEL=z;CARGO_PROFILE_RELEASE_STRIP=symbols;CARGO_PROFILE_RELEASE_LTO=thin</MuslCargoEnvironmentVariables>
    </PropertyGroup>
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../.github/scripts/build-musl.sh&quot; &quot;$(Configuration)&quot;" EnvironmentVariables="$(MuslCargoEnvironmentVariables)" />
  </Target>

  <Target Name="ValidateLinuxMuslLibrary" BeforeTargets="PrepareForBuild;AddNativeRuntimesToPackage" DependsOnTargets="BuildMuslNativeLibrary" Condition="'$(IncludeLinuxMusl)' == 'true'">
    <Error Condition="!Exists('$(LinuxMuslLibraryPath)')" Text="Missing musl library: $(LinuxMuslLibraryPath). Build with BuildLinuxMusl=true first (see README), or set LinuxMuslLibraryPath to a prebuilt musl x64 library." />
  </Target>

  <Target Name="ComputeHostArchitecture" BeforeTargets="GetFilesToPack;GenerateNuspec;Pack;PrepareForBuild">
    <ItemGroup>
      <HostArchitecture Remove="@(HostArchitecture)" />
    </ItemGroup>
    <ItemGroup>
      <HostArchitecture Include="@(BindingsPlatform)" Condition="'%(BindingsPlatform.Identity)' == '$(HostPlatformName)-$(HostArchitectureName)'" />
      <HostArchitecture Include="@(BindingsPlatform)" Condition="'%(BindingsPlatform.Identity)' == '$(HostPlatformName)-arm64' and '$(HostArchitectureName)' == 'x64' and '$(BuildArm64)' == 'true'" />
    </ItemGroup>
    <ItemGroup>
      <NativeLibrary Include="@(HostArchitecture->'$(MSBuildThisFileDirectory)../c2pa-rs/target/%(CargoTarget)/$(Configuration.ToLower())/%(NativeLibrary)')" />
      <GeneratedFile Include="$(BindingsFolder)/C2paBindings.cs" />
    </ItemGroup>
    <Message Text="Host architectures for build: @(HostArchitecture->'%(Identity) ')" Importance="high" />
    <Message Text="Native Libraries @(NativeLibrary) GeneratedFiles:@(GeneratedFile)" Importance="high" />
    <!-- Always copy + pack the native library for the current OS (independent of whether Cargo runs incrementally). -->
    <ItemGroup>
      <Content Include="@(HostArchitecture-> '$(MSBuildThisFileDirectory)../c2pa-rs/target/%(CargoTarget)/$(Configuration.ToLower())/%(NativeLibrary)')" CopyToOutputDirectory="PreserveNewest" Link="runtimes/%(HostArchitecture.Identity)/native/%(HostArchitecture.NativeLibrary)" />
    </ItemGroup>
  </Target>

  <Target Name="AddNativeRuntimesToPackage" DependsOnTargets="ComputeHostArchitecture">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(HostArchitecture->'$(MSBuildThisFileDirectory)../c2pa-rs/target/%(CargoTarget)/$(Configuration.ToLower())/%(NativeLibrary)')">
        <PackagePath>runtimes/%(HostArchitecture.Identity)/native/%(HostArchitecture.NativeLibrary)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="GenerateBindings" DependsOnTargets="Cargo" Inputs="@(NativeLibrary);$(MSBuildProjectFullPath)" Outputs="@(GeneratedFile)">
    <ItemGroup>
      <FirstArch Include="@(HostArchitecture->Reverse())" />
    </ItemGroup>

    <PropertyGroup>
      <CargoOutputForBindings>$(MSBuildThisFileDirectory)../c2pa-rs/target/%(FirstArch.CargoTarget)/$(Configuration.ToLower())/</CargoOutputForBindings>
      <ConfigOptions>-c latest-codegen multi-file generate-file-scoped-namespaces generate-helper-types -hf header</ConfigOptions>
      <InteropArgsCommon>-n ContentAuthenticity.Bindings -l c2pa_c -p c2pa_ -r C2paSigningAlg=SigningAlg uint64_t=ulong char=sbyte -e @(DeprecatedNativeApi, ' ') -x c -a -DC2PA_DYNAMIC_LOADING=1</InteropArgsCommon>
    </PropertyGroup>
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
      <PlatformArgs>-I "`gcc -print-file-name=include`" -Wno-ignored-attributes -Wno-attributes</PlatformArgs>
      <EnvironmentVariables Condition="'$(HostArchitectureName)' == 'x64'">LD_LIBRARY_PATH=$(PkglibClangSharp_runtime_linux_x64)/runtimes/linux-x64/native:$(Pkglibclang_runtime_linux_x64)/runtimes/linux-x64/native</EnvironmentVariables>
      <EnvironmentVariables Condition="'$(HostArchitectureName)' == 'arm64'">LD_LIBRARY_PATH=$(PkglibClangSharp_runtime_linux-arm64)/runtimes/linux-arm64/native:$(Pkglibclang_runtime_linux-arm64)/runtimes/linux-arm64/native</EnvironmentVariables>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
      <PlatformArgs>-I /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/ -I /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks/Kernel.framework/Versions/A/Headers/</PlatformArgs>
      <EnvironmentVariables>DYLD_LIBRARY_PATH=$(PkglibClangSharp_runtime_osx-arm64)/runtimes/osx-arm64/native:$(Pkglibclang_runtime_osx-arm64)/runtimes/osx-arm64/native</EnvironmentVariables>
    </PropertyGroup>

    <Exec Command="$(EnvironmentVariables) dotnet tool run clangsharppinvokegenerator -- -f $(CargoOutputForBindings)c2pa.h -o $(BindingsFolder) $(InteropArgsCommon) -m C2paBindings $(ConfigOptions) $(PlatformArgs)" IgnoreStandardErrorWarningFormat="true" EnvironmentVariables="$(EnvironmentVariables)" />
  </Target>

  <Target Name="IncludeGeneratedBindings" DependsOnTargets="Cargo;GenerateBindings" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="$(BindingsFolder)/*.cs" />
    </ItemGroup>
  </Target>

  <Target Name="Cargo" DependsOnTargets="ComputeHostArchitecture" Outputs="@(NativeLibrary)" Inputs="../c2pa-rs/c2pa_c_ffi/Cargo.toml">
    <Message Text="Building native c2pa_c library for host architectures: @(HostArchitecture->'%(Identity) ')" Importance="high" />
    <PropertyGroup>
      <CargoArgs Condition="'$(Configuration)' == 'Release'">--release</CargoArgs>
      <!-- Opt-in: Release-only Cargo profile tuning. -->
      <CargoEnvironmentVariables Condition="'$(Configuration)' == 'Release' and '$(EnableCargoReleaseOptimizations)' == 'true'">CARGO_PROFILE_RELEASE_OPT_LEVEL=z;CARGO_PROFILE_RELEASE_STRIP=symbols;CARGO_PROFILE_RELEASE_LTO=thin</CargoEnvironmentVariables>
      <!-- Pass all targets in a single cargo invocation; cargo builds them in parallel internally -->
      <CargoTargetArgs>@(HostArchitecture->'--target %(CargoTarget)', ' ')</CargoTargetArgs>
    </PropertyGroup>
    <Exec Command="cargo build $(CargoArgs) --no-default-features --features rust_native_crypto,http,add_thumbnails $(CargoTargetArgs) -p c2pa-c-ffi" EnvironmentVariables="$(CargoEnvironmentVariables)" WorkingDirectory="$(MSBuildThisFileDirectory)../c2pa-rs/" />
  </Target>

  <Target Name="GenerateSchema" DependsOnTargets="Cargo" Inputs="../c2pa-rs/export_schema/Cargo.toml" Outputs="@(SchemaFile)">
    <ItemGroup>
      <FirstArch Include="@(HostArchitecture-&gt;Reverse())" />
    </ItemGroup>
    <PropertyGroup>
      <CargoTarget>%(FirstArch.CargoTarget)</CargoTarget>
      <CargoArgs Condition="'$(Configuration)' == 'Release'">--release</CargoArgs>
    </PropertyGroup>
    <Exec Command="cargo run $(CargoArgs) --no-default-features --features c2pa/rust_native_crypto,c2pa/json_schema --target $(CargoTarget) -p export_schema" WorkingDirectory="$(MSBuildThisFileDirectory)../c2pa-rs" />
  </Target>

  <Target Name="GenerateSchemaModels" DependsOnTargets="GenerateSchema" Inputs="%(SchemaFile.FullPath)" Outputs="$(MSBuildProjectDirectory)/Schema/%(SchemaFile.GeneratedFile)">
    <MakeDir Directories="$(MSBuildProjectDirectory)/Schema" />
    <Exec Command="npx --yes quicktype@$(QuicktypeVersion) --src-lang schema --lang csharp --framework SystemTextJson --namespace ContentAuthenticity.Schema.%(SchemaFile.Namespace) --top-level $([System.IO.Path]::GetFileNameWithoutExtension(%(SchemaFile.Filename))) --out &quot;$(MSBuildProjectDirectory)/Schema/%(SchemaFile.GeneratedFile)&quot; &quot;%(SchemaFile.FullPath)&quot;" />
    <Message Text="Generated schema models with quicktype $(QuicktypeVersion)" Importance="high" />
  </Target>

  <Target Name="GenerateStandardAssertionModels" Inputs="$(MSBuildProjectDirectory)/../schemas/c2pa-standard-assertions.schema.json" Outputs="$(MSBuildProjectDirectory)/Schema/StandardAssertions.cs">
    <MakeDir Directories="$(MSBuildProjectDirectory)/Schema" />
    <Exec Command="npx --yes quicktype@$(QuicktypeVersion) --src-lang schema --lang csharp --framework SystemTextJson --namespace ContentAuthenticity.Schema --top-level C2PaStandardAssertionsSchema --out &quot;$(MSBuildProjectDirectory)/Schema/StandardAssertions.cs&quot; &quot;$(MSBuildProjectDirectory)/../schemas/c2pa-standard-assertions.schema.json&quot;" />
    <Message Text="Generated standard assertion models with quicktype $(QuicktypeVersion)" Importance="high" />
  </Target>

  <Target Name="PrepareGenerateModels" Condition="'$(ForceGenerateModels)' == 'true'">
    <Delete Files="@(SchemaFile)" />
  </Target>

  <Target Name="GenerateModels" DependsOnTargets="PrepareGenerateModels;GenerateSchemaModels;GenerateStandardAssertionModels" />

  <Target Name="IncludeGeneratedSchemaModels" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Compile Include="@(SchemaFile->'$(MSBuildProjectDirectory)/Schema/%(GeneratedFile)')" />
    </ItemGroup>
  </Target>
</Project>
